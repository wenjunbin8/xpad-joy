@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"

rem Build the client exe with PyInstaller. This file does NOT install anything by itself:
rem   pyinstaller must already be installed (pip install pyinstaller).
rem --windowed: only the GUI window, no black console window. The source client.py stays
rem in this folder unchanged. Errors that used to go to the console are written to
rem Xpad-joy.log next to the exe (see say() in client.py).

where py >nul 2>nul
if errorlevel 1 (
    echo [ERROR] py launcher not found, cannot build.
    pause
    exit /b 1
)

py -3 -c "import PyInstaller" >nul 2>nul || (
    echo [ERROR] pyinstaller not installed. Run: pip install pyinstaller
    pause
    exit /b 1
)

rem Icon: icon.ico is generated by tools\make_icon.py (multi-size 16/24/32/48/64/128/256).
rem --icon puts it on the exe; --add-data bundles it so client.py can set the Tk window icon too.
set ICONFLAG=
if exist "icon.ico" (
    set ICONFLAG=--icon "icon.ico" --add-data "icon.ico;."
) else (
    echo [WARN] icon.ico not found here. Run tools\make_icon.py once; without it the exe keeps the
    echo        default icon.
)

rem ViGEmClient.dll: vgamepad loads it at import time from
rem   <site-packages>\vgamepad\win\vigem\client\<arch>\ViGEmClient.dll
rem PyInstaller does NOT collect that DLL (it is not an import), so a onefile exe used to
rem fail to import vgamepad -> the client received packets but never created the gamepad.
rem Bundle the whole vigem folder so the path matches inside _MEIPASS.
set VIGEMFLAG=
rem find_spec (not import): importing vgamepad connects to ViGEmBus at import time, so the
rem path lookup must not run the module — otherwise the path comes out empty when the driver
rem is not installed and the DLL would be skipped.
for /f "delims=" %%i in ('py -3 -c "import importlib.util as u; s=u.find_spec('vgamepad'); print(s.submodule_search_locations[0])"') do set VGPDIR=%%i
if exist "%VGPDIR%\win\vigem" (
    set VIGEMFLAG=--add-data "%VGPDIR%\win\vigem;vgamepad\win\vigem"
) else (
    echo [WARN] vgamepad\win\vigem not found -> the exe will not be able to create the virtual pad.
)

echo [BUILD] pyinstaller --onefile --windowed --name Xpad-joy --clean [icon] [vigem dll] client.py
py -3 -m PyInstaller --onefile --windowed --name Xpad-joy --clean %ICONFLAG% %VIGEMFLAG% client.py
if errorlevel 1 (
    echo [ERROR] build failed. See the output above.
    pause
    exit /b 1
)

copy /y dist\Xpad-joy.exe Xpad-joy.exe >nul
echo [OK] Xpad-joy.exe ready next to this bat. The launcher bat (qi dong ke hu duan.bat) uses it automatically.
:end
pause
